# ==============================================================================
# Kalisi SMP Phone Agent — Environment Configuration
# Target: Android OPPO Phone (Termux)
# ==============================================================================

# Server Network & Host
PORT=8728
HOST=127.0.0.1
DEBUG=false

# Minecraft Server Directories & Specs
MINECRAFT_DIR=/data/data/com.termux/files/home/minecraft-server
SERVER_JAR=paper.jar
JAVA_BIN=java
MIN_RAM=1G
MAX_RAM=3G

# Security & Authentication
# Generate with: openssl rand -hex 32
JWT_SECRET=replace_with_a_secure_random_64_char_hex_secret_key
# API Secret key for external scripts or direct header auth
API_SECRET_KEY=replace_with_secure_api_secret_key
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace_with_strong_password
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# Cloudflare Zero Trust / Access Protection (Recommended)
# Found in Cloudflare Zero Trust dashboard under Access -> Applications
CLOUDFLARE_ACCESS_TEAM_DOMAIN=
CLOUDFLARE_AUD_TAG=
